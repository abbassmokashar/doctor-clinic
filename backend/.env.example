# Database - Supabase
# Use Session Pooler URL (port 6543) with pgbouncer=true for runtime
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection URL (port 5432) for migrations
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# JWT Secret
JWT_SECRET=your-jwt-secret-key-change-in-production
