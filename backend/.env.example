# Database (SQLite - local file)
DATABASE_URL="file:./prisma/dev.db"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000

# WhatsApp Reminders (optional - defaults to console logging)
# WHATSAPP_MODE=live
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WhatsApp country code for phone formatting (default: 212 for Morocco)
# WHATSAPP_COUNTRY_CODE=212
# WHATSAPP_API_VERSION=v23.0

# Reminder Cron Schedule (default: 9:00 AM daily)
# REMINDER_CRON_SCHEDULE="0 9 * * *"
